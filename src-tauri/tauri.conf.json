{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ТермоОпрос",
  "mainBinaryName": "termoopros",
  "version": "../package.json",
  "identifier": "io.github.whiskm.termoopros",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "ТермоОпрос",
        "width": 1120,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "ТермоОпрос",
    "category": "Education",
    "shortDescription": "Подготовка к зачету по технической термодинамике",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
